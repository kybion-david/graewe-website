# Site URL (used for sitemap generation and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.graewe.com

# Resend API key for contact form emails (required for successful submits)
# Sign up at https://resend.com, verify graewe.com (or your sending domain), and create an API key.
# Without this key the API returns 503 (email_unavailable) and the UI shows an error — never a fake success.
# Production: set GitHub secret RESEND_API_KEY (wired in .github/workflows/deploy.yml) and mirror in Azure SWA app settings if needed.
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email addresses for contact form
# CONTACT_EMAIL_TO — inbox that receives submissions (verify with a real test before DNS cutover)
# CONTACT_EMAIL_FROM — must be a Resend-verified sender/domain
CONTACT_EMAIL_TO=info@graewe.com
CONTACT_EMAIL_FROM=website@graewe.com

# Cloudflare Turnstile (contact form spam protection)
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Without these keys, honeypot + rate limiting still apply; the Turnstile widget is hidden.
# Cloudflare test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
