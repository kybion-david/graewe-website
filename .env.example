# Site URL (used for sitemap generation and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.graewe.com

# Resend API key for contact form emails
# Sign up at https://resend.com, verify your domain, and create an API key.
# Without this key, contact submissions are logged to console instead of emailed.
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email addresses for contact form
CONTACT_EMAIL_TO=info@graewe.com
CONTACT_EMAIL_FROM=website@graewe.com

# Cloudflare Turnstile (contact form spam protection)
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Without these keys, honeypot + rate limiting still apply; the Turnstile widget is hidden.
# Cloudflare test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
